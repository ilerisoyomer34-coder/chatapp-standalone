  "categories": ["social", "communication"],
  "icons": [
    { "src": "/chatapp-standalone/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/chatapp-standalone/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/chatapp-standalone/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/chatapp-standalone/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/chatapp-standalone/icons/badge-96.png", "sizes": "96x96", "type": "image/png", "purpose": "monochrome" }
  ],
  "screenshots": [
    { "src": "/chatapp-standalone/screenshots/narrow.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "Bire bir sohbet: yanıt, tepki ve okundu bilgisi" },
    { "src": "/chatapp-standalone/screenshots/wide.png", "sizes": "1280x820", "type": "image/png", "form_factor": "wide", "label": "Masaüstünde grup sohbeti" }
  ],
  "shortcuts": [
