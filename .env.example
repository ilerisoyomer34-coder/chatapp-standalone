# ChatApp ortam değişkenleri
# Bu dosyayı ".env" adıyla kopyala ve değerleri doldur. ".env" depoya girmez.
# Firebase Console → Proje ayarları → Genel → "Uygulamalarınız" → Web uygulaması → SDK yapılandırması
# GitHub Actions için aynı adlarla depo "Secrets" (Settings → Secrets and variables → Actions) ekle.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=chatapp-d8a5b.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://chatapp-d8a5b-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=chatapp-d8a5b
VITE_FIREBASE_STORAGE_BUCKET=chatapp-d8a5b.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=968851351219
VITE_FIREBASE_APP_ID=

# Cloud Messaging → Web yapılandırması → Web Push sertifikaları → Anahtar çifti (açık anahtar)
VITE_FIREBASE_VAPID_KEY=

# App Check → reCAPTCHA v3 site anahtarı (boş bırakılırsa App Check başlatılmaz)
VITE_RECAPTCHA_SITE_KEY=

# Yalnızca yerel geliştirme: App Check hata ayıklama belirteci kullan (true/false)
VITE_APPCHECK_DEBUG=false

# B planı (Blaze yoksa): Cloudflare Worker bildirim uç noktası, ör. https://chatapp-push.<hesap>.workers.dev
# A planında (Cloud Functions) boş bırak.
VITE_PUSH_WORKER_URL=
